<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lsy.seckill.modules.goods.mapper.GoodsMapper">

    <!-- 分页查询（分页由 MyBatis-Plus 分页插件自动拼接 LIMIT） -->
    <select id="selectPageByName" resultType="com.lsy.seckill.modules.goods.entity.Goods">
        SELECT id, name, price, status, create_time, update_time
        FROM goods
        <where>
            <if test="name != null and name != ''">
                name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>
